{
  "name": "nishio-piano-school-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "dev:pages": "wrangler pages dev dist --kv SITE_KV --r2 SITE_PHOTOS --binding ALLOW_LOCAL_ADMIN_BYPASS=true"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "jose": "^6.2.18"
  }
}
